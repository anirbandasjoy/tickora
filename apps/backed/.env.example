# Server Configuration
PORT=8000
NODE_ENV=development
SERVER_URI=http://localhost:8000
CLIENT_URI=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Database
MONGO_URI=mongodb://localhost:27017/tickora
DB_TRANSACTIONS=false

# Better Auth
BETTER_AUTH_SECRET=replace-with-a-random-32-plus-char-secret
BETTER_AUTH_URL=http://localhost:8000

# Google OAuth (Google Cloud Console → Credentials → OAuth client ID → Web application)
# Authorized redirect URI: http://localhost:8000/api/auth/callback/google
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Email (Resend — https://resend.com/api-keys)
# Leave unset in dev: emails are logged to console instead of sent.
RESEND_API_KEY=re_your_api_key
EMAIL_FROM=Tickora <no-reply@yourdomain.com>

